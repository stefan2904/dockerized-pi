{
  "lastChangelogVersion": "0.85.1",
  "theme": "modern-dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "shellPath": "/bin/zsh",
  "shellCommandPrefix": "setopt aliases\nsource ~/.zshrc",
  "images": {
    "autoResize": true
  },
  "editorPaddingX": 0,
  "collapseChangelog": true,
  "enabledModels": [
    "openrouter/openrouter/free",
    "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-6-astra",
    "hetzner/Qwen3.8-27B",
    "hetzner/Qwen/Qwen3.6-35B-A3B-FP8"
  ],
  "packages": [
    {
      "source": "git:github.com/mitsuhiko/agent-stuff",
      "extensions": [
        "-extensions/files.ts",
        "-extensions/loop.ts",
        "-extensions/go-to-bed.ts",
        "-extensions/answer.ts"
      ],
      "skills": [
        "-skills/web-browser/SKILL.md",
        "-skills/openscad/SKILL.md",
        "-skills/apple-mail/SKILL.md"
      ],
      "themes": [
        "+themes/modern-dark.json",
        "+themes/nightowl.json"
      ]
    },
    "git:github.com/lucasmeijer/pi-terminal-signals",
    "npm:pi-mcp-adapter",
    {
      "source": "npm:pi-web-access",
      "skills": [
        "-skills/librarian/SKILL.md"
      ]
    }
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "doubleEscapeAction": "tree",
  "treeFilterMode": "user-only",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "fullscreenScrollbar": "always",
  "tuiMode": "fullscreen",
  "outputPad": 1,
  "showHardwareCursor": false,
  "showCacheMissNotices": true
}
